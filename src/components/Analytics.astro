---
interface Props {
  gaId: string;
}

const { gaId } = Astro.props;
---

<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
></script>
<script is:inline define:vars={{ gaId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  gtag('js', new Date());
  gtag('config', gaId);
</script>
