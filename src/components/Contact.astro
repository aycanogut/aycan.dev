---
import { site, socials } from '@/data/site';

const year = new Date().getFullYear();
---

<section
  id="contact"
  class="scroll-mt-18 border-t border-line-soft bg-bg-alt dot-grid pt-24 md:pt-36 lg:pt-44"
>
  <div class="mx-auto max-w-site px-5 sm:px-8 lg:px-16">
    <div data-reveal class="mb-10 flex items-center gap-4 md:mb-14 lg:mb-16">
      <span class="font-mono text-xs font-medium tracking-label text-fg-3 uppercase">
        Contact
      </span>
      <span class="h-px flex-1 bg-line"></span>
    </div>

    <h2
      data-reveal
      data-delay="80"
      class="max-w-[16ch] font-display text-5xl leading-none text-balance text-ink uppercase md:text-7xl lg:text-8xl"
    >
      Have a project in mind?<span
        class="blink ml-[0.1em] h-[0.82em] w-[0.4em] align-[-0.02em]"></span>
    </h2>

    <a
      data-reveal
      data-delay="140"
      href={`mailto:${site.email}`}
      class="mt-9 inline-block rounded-xs font-sans text-3xl font-medium tracking-tight wrap-anywhere text-ink no-underline decoration-1 underline-offset-8 transition-colors duration-200 hover:text-accent hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent md:mt-12 md:text-5xl lg:mt-14 lg:text-7xl"
    >
      {site.email}
    </a>

    <div
      data-reveal
      data-delay="200"
      class="mt-12 flex flex-wrap gap-x-10 gap-y-3.5 md:mt-16 lg:mt-18"
    >
      {
        socials.map((social) => (
          <a
            href={social.href}
            target={social.href.startsWith('http') ? '_blank' : undefined}
            rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="inline-flex items-center gap-2 rounded-xs font-mono text-sm tracking-wide text-fg-3 no-underline transition-colors duration-200 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            {social.label}
            {social.href.startsWith('http') && (
              <>
                <span aria-hidden="true" class="text-sm">
                  ↗
                </span>
                <span class="sr-only">(opens in a new tab)</span>
              </>
            )}
          </a>
        ))
      }
    </div>

    <footer
      class="mt-20 flex flex-wrap items-center justify-between gap-x-6 gap-y-3.5 border-t border-line-soft py-7 md:mt-32 lg:mt-36"
    >
      <span class="font-mono text-xs tracking-wide text-fg-5">
        © {year} 
         {site.name}
      </span>
      <a
        href="#top"
        class="rounded-xs font-mono text-xs tracking-wide text-fg-3 no-underline transition-colors duration-200 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        Back to top <span aria-hidden="true">↑</span>
      </a>
    </footer>
  </div>
</section>
